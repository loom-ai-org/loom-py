# The ARMv6 wheel's build environment: a Raspberry Pi Zero's own userland, emulated.
#
#   docker run --privileged --rm tonistiigi/binfmt --install arm      # once per boot
#   docker build --platform linux/arm/v6 -t loom-armv6-build:bookworm -f .github/docker/Dockerfile.armv6 .github/docker
#   docker run --rm --platform linux/arm/v6 -v "$PWD:/src" -w /src loom-armv6-build:bookworm \
#       /opt/wheel/bin/python -m build --wheel --no-isolation -o wheelhouse
#
# AGAINST A CLEAN CHECKOUT, NOT A TREE YOU DEVELOP IN. `_loom`'s POST_BUILD step copies every
# `.so` it just built into the source tree's `loom/` package directory, which is what makes a plain
# `cmake --build build` leave a working `import loom` -- and here that means ARMv6 libraries landing
# on top of the x86-64 ones your own checkout imports. CI runs on a fresh `actions/checkout`, so this
# only bites a local run; copy the tree (with its submodule) or clone one.
#
# WHY A CONTAINER OF THE TARGET RATHER THAN A CROSS-COMPILER, and it is not convenience. Three of the
# things this build needs are decided by the userland it runs in rather than by a flag:
#
#   * THE WHEEL TAG. `linux_armv6l` comes from `sysconfig.get_platform()` of the interpreter that
#     builds it. A cross build produces a wheel tagged for the HOST, and nothing downstream notices.
#   * THE DEFAULT -march. `GGML_NATIVE` is off and the 32-bit path passes no `-march` at all
#     (loom-py/CMakeLists.txt says why), so the baseline is the compiler's own default. Raspbian's
#     gcc is configured `--with-arch=armv6 --with-fpu=vfp --with-float=hard`; Debian's armhf gcc --
#     the one a `arm32v7/debian` image or a `crossbuild-essential-armhf` toolchain gives you -- is
#     armv7-a+neon, and a wheel built with it SIGILLs on an ARM1176 rather than failing to install.
#   * LIBGCC. Even with the right `-march` on our own translation units, the static parts of libgcc
#     get linked in from wherever the toolchain lives. Debian armhf's is built for ARMv7 and contains
#     `movw`/`movt`, which is ARMv6T2 and up -- and the Pi Zero's ARM1176 is ARMv6Z, which is not.
#
# Raspbian is the distribution that answers all three, because it is the one that exists to be ARMv6:
# Debian's armhf port has an ARMv7 baseline, and the Raspberry Pi Foundation rebuilt the archive to
# drop it back to the Pi 1 / Zero. glibc 2.36 here, 2.36 on the board.
#
# LuaJIT is why there is no cross-compilation fallback either: it bootstraps through `minilua` and
# `buildvm`, which run on the HOST, so cross-building it needs a HOST_CC/TARGET_CFLAGS split that
# cmake/Dependencies.cmake deliberately does not set up (it raises rather than mis-build). Emulated,
# the host IS the target and the question does not arise.
FROM balenalib/rpi-raspbian:bookworm

# EVERY COMPILED DEPENDENCY FROM apt, NOT FROM pip, and on this architecture that is the difference
# between an image and an afternoon. PyPI has no `linux_armv6l` wheel for ANYTHING, so every pip
# install of a package with an extension module falls through to building it from source inside an
# emulator: cmake and ninja (scikit-build-core fetches its own of both when it cannot find them),
# numpy, pytest's dependencies. Raspbian has all of them compiled already, for this exact ISA.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git ca-certificates pkg-config \
      python3 python3-dev python3-venv python3-pip \
      python3-numpy python3-pytest python3-yaml python3-tqdm \
    && rm -rf /var/lib/apt/lists/*

# `gguf` is the one test dependency apt does not carry, and it is pure Python -- so `--no-deps` and
# the three packages it would have pulled (numpy, pyyaml, tqdm) come from the apt line above instead.
# Without `--no-deps` pip decides numpy needs building and the image stops being buildable in an hour.
# `sentencepiece` is a fourth declared dependency and is NOT installed: nothing tests/ci does with
# `gguf` (writing a small GGUF with `GGUFWriter`) imports it.
#
# `--break-system-packages` because Debian 12 marks its interpreter externally-managed (PEP 668).
# Into the system interpreter deliberately: the venvs below are `--system-site-packages`, so this is
# installed once and visible to the build venv and to whatever venv a test step creates.
RUN pip3 install --no-cache-dir --break-system-packages --no-deps gguf

# A venv for the build, because PEP 668 again -- and `--system-site-packages` so the apt-installed
# numpy/pytest/gguf above are in it. `build` + `--no-isolation` at the call site because pip's default
# isolated build environment would re-resolve scikit-build-core and pybind11 on every invocation;
# both are pure Python and install once, here.
RUN python3 -m venv --system-site-packages /opt/wheel \
    && /opt/wheel/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/wheel/bin/pip install --no-cache-dir "scikit-build-core>=0.9" "pybind11>=2.12" build
